{
  "name": "ischatgptcitingyou",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "description": "AI-crawler traffic pipeline. Forwards bot/AI page-view traffic from your site to your analytics destination. Self-host or hosted. Stores no traffic data.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push --force",
    "db:rls": "tsx src/db/applyRls.ts",
    "isolation:selftest": "tsx src/db/isolationSelfTest.ts",
    "posture:assert": "tsx src/config/assertPosture.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.658.0",
    "@upstash/redis": "^1.34.0",
    "better-auth": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "^15.1.0",
    "postgres": "^3.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.4.0",
    "undici": "^6.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
