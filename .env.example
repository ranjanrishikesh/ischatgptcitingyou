# ============================================================================
# ischatgptcitingyou — environment template. Copy to .env.local for dev.
# NEVER commit a filled-in copy. Secrets in prod live in Vercel env settings.
# ============================================================================

# --- Deployment mode -------------------------------------------------------
# "self_host" (default) — you run it, your secrets stay in your env.
# "hosted"    — our multi-tenant platform. Boots ONLY if the full security
#               posture is satisfied (real KMS, FORCE RLS, per-tenant DEKs).
DEPLOY_MODE=self_host

# --- Database --------------------------------------------------------------
# RUNTIME role: must be a NON-owner, NON-superuser, NO-BYPASSRLS role.
# RLS is silently inert for table owners — the app must never connect as one.
DATABASE_URL=postgres://app_runtime:password@localhost:5432/icy
# OWNER/migration role: used only by drizzle migrations + applyRls. Never at runtime.
DATABASE_OWNER_URL=postgres://app_owner:password@localhost:5432/icy
# The runtime login role name. MUST equal the role in DATABASE_URL. applyRls grants
# this role table DML + EXECUTE on the resolver functions. Required when an owner
# role is used (applyRls hard-errors without it).
RUNTIME_DB_ROLE=app_runtime

# --- Key Encryption Key (KEK) provider ------------------------------------
# hosted  -> MUST be "kms"  (a bare master key is rejected at boot)
# self_host -> "kms" (recommended: bring your own KMS/Vault) or "file" fallback.
KEK_PROVIDER=file

# file provider (self-host fallback ONLY): path to a 0400 file holding a
# 32-byte key (base64). NOT an env var on purpose — env leaks more easily.
# In this mode the KEK sits next to the ciphertext: a DB dump + this file =
# full recovery. Do not market "nothing decryptable from a DB dump" here.
KEK_FILE_PATH=./secrets/master.key

# kms provider: ARN/key id of the CMK used to wrap per-tenant DEKs.
KMS_KEY_ID=
AWS_REGION=us-east-1

# --- Redis (hot meter + locks; HOSTED only) --------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth (Better Auth) ----------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Stripe (billing; HOSTED only) -----------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable (NOT secret) key, used by Stripe Elements in the dashboard to
# collect card details client-side. Card data goes straight to Stripe.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Reconcile cron + email (HOSTED only) ----------------------------------
# Bearer secret callers must present to /api/cron/reconcile (a charge-triggering
# endpoint — treat like a password). Generate: openssl rand -base64 32
# The same value goes in the GitHub repo secret used by .github/workflows/reconcile.yml.
CRON_SECRET=
# Email provider for billing notifications (Resend). If unset, emails are no-op'd.
RESEND_API_KEY=
EMAIL_FROM=noreply@ischatgptcitingyou.com

# --- Google (Sheets destination, OAuth) ------------------------------------
# Platform-level OAuth client. client_secret is a TOP-TIER secret (not per-tenant).
# Scope requested is least-privilege: drive.file (+ spreadsheets on app-created files).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Ingest -----------------------------------------------------------------
# Server-side pepper used to MAC ingest ids so forged ids are rejected O(1),
# with zero DB hits, at the edge. Rotate-able. Keep secret.
INGEST_ID_PEPPER=
